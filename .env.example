# https://developers.kakao.com/
# 주변 가게 목록용 (REST 키 권장)
VITE_KAKAO_REST_KEY=
VITE_KAKAO_JS_KEY=

# GitHub Pages 등 정적 호스팅에서 CORS 우회용 프록시 (Cloudflare Worker)
# 예: https://omaju-kakao-proxy.your-subdomain.workers.dev
VITE_KAKAO_API_BASE=

# AI 챗 LITE 모드 NLG (SpaceXAI / xAI) — Cloudflare Worker
# 배포: npx wrangler deploy workers/omaju-nlg-proxy.js --name omaju-nlg-proxy
# secret: npx wrangler secret put XAI_API_KEY
# 예: https://omaju-nlg-proxy.your-subdomain.workers.dev
VITE_NLG_API_BASE=
